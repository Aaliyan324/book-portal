# Neon PostgreSQL Database Connection Strings
# Replace with your actual Neon PostgreSQL connection string from https://neon.tech
DATABASE_URL="postgresql://user:password@ep-example-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-example.us-east-2.aws.neon.tech/neondb?sslmode=require"

# JWT Secret for Session Authentication
JWT_SECRET="hopenix-production-jwt-secret-key-change-in-production"

# Initial Admin Credentials (Used by prisma/seed.ts)
ADMIN_EMAIL="admin@hopenix.com"
ADMIN_INITIAL_PASSWORD="admin123"

# Application Public Base URL (Used for QR code generation and public links)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Vercel Blob Storage Token (For uploading images, videos, PDFs, and resources)
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_token_example"

